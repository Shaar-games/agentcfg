# Generated by CI against the actual compiled agentcfg CLI.
Output docs/demo/agentcfg-config.gif
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 22
Set Width 1080
Set Height 610
Set Theme "Catppuccin Mocha"
Set Framerate 12
Set TypingSpeed 45 ms
Set CursorBlink false
Set WindowBar Colorful

Env HOME "/vhs/.demo/home"
Env PATH "/vhs/.demo/bin:/usr/local/bin:/usr/bin:/bin"
Env TERM "xterm-256color"

Type "agentcfg config"
Enter
Wait+Screen /Configuration/
Sleep 800 ms
Down
Enter
Wait+Screen /Back to main menu/
Sleep 900 ms
Enter
Wait+Screen /Change sharing mode/
Sleep 700 ms
Down 2
Enter
Wait+Screen /MCP details/
Sleep 1 s
Enter
Sleep 300 ms
Ctrl+C
Sleep 300 ms
Ctrl+C
Sleep 300 ms
Type "agentcfg mcps --plain"
Enter
Wait+Screen /playwright/
Sleep 1 s
